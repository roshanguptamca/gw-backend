[Unit]
Description=SecureWise lightweight worker database connectivity check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=securewise-worker
Group=securewise-worker
EnvironmentFile=/etc/securewise/worker.env
Environment=SECUREWISE_WORKER_PROFILE=lightweight
WorkingDirectory=/opt/securewise/backend
ExecStart=/usr/bin/env SECUREWISE_WORKER_PROFILE=lightweight /opt/securewise/venv-lightweight/bin/python manage.py securewise_worker --check-connectivity --skip-checks --worker-id lightweight-connectivity-check
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/securewise-worker
StateDirectory=securewise-worker
StateDirectoryMode=0700
Environment=TMPDIR=/var/lib/securewise-worker
CPUQuota=100%
MemoryMax=256M
MemorySwapMax=512M
TasksMax=64
LimitNOFILE=2048
