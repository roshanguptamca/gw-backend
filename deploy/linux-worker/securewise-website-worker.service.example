[Unit]
Description=SecureWise passive website worker (authorized passive_http only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=securewise-worker
Group=securewise-worker
EnvironmentFile=/etc/securewise/website-worker.env
Environment=SECUREWISE_WORKER_PROFILE=website_passive
WorkingDirectory=/opt/securewise/website-backend
ExecStart=/opt/securewise/venv-lightweight/bin/python manage.py securewise_worker --poll-interval 3 --skip-checks
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=securewise-website-worker
StateDirectoryMode=0700
Environment=TMPDIR=/var/lib/securewise-website-worker
ReadWritePaths=/var/lib/securewise-website-worker
# Leaves headroom for the lightweight worker on a 1 GB host; a breach is killed, not swapped.
CPUQuota=40%
MemoryHigh=160M
MemoryMax=224M
MemorySwapMax=0
TasksMax=64
LimitNOFILE=1024
KillMode=mixed

[Install]
WantedBy=multi-user.target
