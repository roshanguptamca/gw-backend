SECRET_KEY=prod-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db.sqlite3
STATIC_URL=/static/
MEDIA_URL=/media/
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
OPENAI_API_KEY=your_openai_api_key
AI_PROVIDER=dummy
AI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434
CAREER_SUITE_TEMP_TTL_HOURS=24
CAREER_SUITE_RUN_JOBS_INLINE=true
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=eu-west-1
S3_BUCKET=your_s3_bucket_name

ENV=DEV  # DEV for local, PROD for production

# ── FutureWise / DearTomorrow ──────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_v3_api_key

# ── Encryption at rest ────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting reminder subject/message fields in the database.
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MESSAGE_ENCRYPTION_KEY=<generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BREVO_SENDER_EMAIL=noreply@guidewisey.com
BREVO_SENDER_NAME=FutureWise by GuideWisey

# Reminder scheduling limits (optional — shown with defaults)
FUTUREWAVE_MAX_RETRIES=3
FUTUREWAVE_RETRY_BASE_DELAY_SECONDS=300
FUTUREWAVE_MIN_SCHEDULE_MINUTES=30
FUTUREWAVE_MAX_SCHEDULE_YEARS=10
FUTUREWAVE_MAX_ATTACHMENT_BYTES=10485760
FUTUREWAVE_MAX_ATTACHMENTS=5
FUTUREWAVE_ATTACHMENT_PURGE_AFTER_SEND=true
FUTUREWAVE_FRONTEND_BASE_URL=https://www.guidewisey.com
EMAIL_REMINDER_FREE_DAILY_LIMIT=3
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ── Multi-Channel Reminder Providers ──────────────────────────────────────────
# Twilio (SMS + Voice Call + WhatsApp Sandbox)
# Sign up at https://www.twilio.com/try-twilio (free trial)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_WHATSAPP_NUMBER=+14155238886

# Telegram Bot API
# Create a bot via @BotFather on Telegram, then copy the token here.
TELEGRAM_BOT_TOKEN=123456789:AAF-your-telegram-bot-token

# Rate limits
FUTUREWAVE_ANON_CREATE_RATE=5/hour
FUTUREWAVE_USER_CREATE_RATE=20/hour
FUTUREWAVE_VERIFY_RATE=10/hour

# Sentry DSN (optional — for observability)
SENTRY_DSN=
