SECRET_KEY=prod-secret-key
DEBUG=False
ALLOWED_HOSTS=api.guidewisey.com,guidewisey.com,www.guidewisey.com,gw-backend-eq2n.onrender.com,localhost,127.0.0.1
DB_ENGINE=django.db.backends.postgresql
DB_NAME=db.sqlite3
STATIC_URL=/static/
MEDIA_URL=/media/
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CORS_ALLOWED_ORIGINS=https://guidewisey.com,https://www.guidewisey.com,http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.guidewisey.com,https://guidewisey.com,https://www.guidewisey.com,http://localhost,http://127.0.0.1
OPENAI_API_KEY=your_openai_api_key
AI_PROVIDER=gemini
AI_PROVIDER_FALLBACKS=gemini,openai
AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Resume parsing uses the configured AI provider. Use "dummy" for deterministic-only parsing.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434
CAREER_SUITE_TEMP_TTL_HOURS=24
CAREER_SUITE_RUN_JOBS_INLINE=true
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=eu-west-1
S3_BUCKET=your_s3_bucket_name

ENV=DEV  # DEV for local, PROD for production

# ── FutureWise / DearTomorrow ──────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_v3_api_key

# ── Encryption at rest ────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting reminder subject/message fields in the database.
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MESSAGE_ENCRYPTION_KEY=<generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BREVO_SENDER_EMAIL=noreply@guidewisey.com
BREVO_SENDER_NAME=FutureWise by GuideWisey

# Reminder scheduling limits (optional — shown with defaults)
FUTUREWAVE_MAX_RETRIES=3
FUTUREWAVE_RETRY_BASE_DELAY_SECONDS=300
FUTUREWAVE_MIN_SCHEDULE_MINUTES=30
FUTUREWAVE_MAX_SCHEDULE_YEARS=10
FUTUREWAVE_MAX_ATTACHMENT_BYTES=10485760
FUTUREWAVE_MAX_ATTACHMENTS=5
FUTUREWAVE_ATTACHMENT_PURGE_AFTER_SEND=true
FUTUREWAVE_FRONTEND_BASE_URL=https://www.guidewisey.com
EMAIL_REMINDER_FREE_DAILY_LIMIT=3
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# ── Multi-Channel Reminder Providers ──────────────────────────────────────────
# Twilio (SMS + Voice Call + WhatsApp Sandbox)
# Sign up at https://www.twilio.com/try-twilio (free trial)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006
TWILIO_WHATSAPP_NUMBER=+14155238886

# Telegram Bot API
# Create a bot via @BotFather on Telegram, then copy the token here.
TELEGRAM_BOT_TOKEN=123456789:AAF-your-telegram-bot-token

# Rate limits
FUTUREWAVE_ANON_CREATE_RATE=5/hour
FUTUREWAVE_USER_CREATE_RATE=20/hour
FUTUREWAVE_VERIFY_RATE=10/hour

# Sentry DSN (optional — for observability)
SENTRY_DSN=

# ── Social authentication ─────────────────────────────────────────────────────
# Register these exact callback URLs with each provider:
# http://localhost:8000/api/auth/oauth/{google|facebook|linkedin|oidc}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_API_VERSION=v23.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Keycloak example: https://sso.example.com/realms/guidewisey
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_AUTH_SUCCESS_URL=https://www.guidewisey.com/auth-callback?status=success
FRONTEND_AUTH_ERROR_URL=https://www.guidewisey.com/auth-callback?error=
OAUTH_TRANSACTION_TTL_MINUTES=10
OAUTH_START_RATE=20/hour
OAUTH_CALLBACK_RATE=30/hour

# ── Speaking Buddy ───────────────────────────────────────────────────────────
SPEAKING_BUDDY_MODEL=gpt-4o-mini
SPEAKING_BUDDY_REALTIME_MODEL=gpt-realtime-2
SPEAKING_BUDDY_MAX_AVATAR_BYTES=5242880
IMAGE_TO_3D_PROVIDER=template
AVATAR_GENERATION_PROVIDER=template
ENABLE_EXPERIMENTAL_IMAGE_TO_3D=false
TRIPOSR_MODEL_PATH=
INSTANTMESH_MODEL_PATH=
PIFUHD_MODEL_PATH=
PSHUMAN_MODEL_PATH=

# ── Marketplace Seed ─────────────────────────────────────────────────────────
# Password for the Rishi Kitchen seller account created by seed_rishi_kitchen.
# If not set, a random password is auto-generated and printed during the seed run.
RISHI_KITCHEN_PASSWORD=

# Cloudinary product image uploads (backend only; never expose API_SECRET)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=guidewisey/products
