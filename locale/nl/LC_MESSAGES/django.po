# ── Accounts / Authentication ─────────────────────────────────────────────────

msgid "CSRF cookie set"
msgstr "CSRF-cookie ingesteld"

msgid "User created"
msgstr "Gebruiker aangemaakt"

msgid "An account with this email address already exists."
msgstr "Er bestaat al een account met dit e-mailadres."

msgid "Passwords must match"
msgstr "Wachtwoorden moeten overeenkomen"

msgid "Logged in"
msgstr "Ingelogd"

msgid "Invalid credentials"
msgstr "Ongeldige inloggegevens"

msgid "Your email confirmation is pending. Please check your inbox and confirm your email before logging in."
msgstr "Uw e-mailbevestiging is in behandeling. Controleer uw inbox en bevestig uw e-mailadres voordat u inlogt."

msgid "Logged out"
msgstr "Uitgelogd"

msgid "Password changed successfully."
msgstr "Wachtwoord succesvol gewijzigd."

msgid "Current password is incorrect."
msgstr "Huidig wachtwoord is onjuist."

msgid "New passwords must match."
msgstr "Nieuwe wachtwoorden moeten overeenkomen."

msgid "New password must differ from current password."
msgstr "Nieuw wachtwoord moet afwijken van het huidige wachtwoord."

msgid "Email confirmed successfully."
msgstr "E-mailadres succesvol bevestigd."

msgid "This confirmation link is invalid or has expired."
msgstr "Deze bevestigingslink is ongeldig of verlopen."

msgid "Confirmation email resent."
msgstr "Bevestigingsmail opnieuw verzonden."

msgid "Email is required."
msgstr "E-mailadres is vereist."

msgid "This email address is already confirmed."
msgstr "Dit e-mailadres is al bevestigd."

msgid "Password reset email sent. Please check your inbox (and spam folder)."
msgstr "E-mail voor wachtwoordherstel verzonden. Controleer uw inbox (en map met spam)."

msgid "No account found with that email address. Please check and try again."
msgstr "Geen account gevonden met dat e-mailadres. Controleer het en probeer het opnieuw."

msgid "Failed to send the reset email. Please try again in a few minutes."
msgstr "Kan de herstelmail niet verzenden. Probeer het over een paar minuten opnieuw."

msgid "This reset link is invalid or has expired."
msgstr "Deze herstelkoppeling is ongeldig of verlopen."

msgid "Password reset successfully."
msgstr "Wachtwoord succesvol hersteld."

msgid "Invalid or missing language code."
msgstr "Ongeldige of ontbrekende taalcode."

msgid "Language preference updated."
msgstr "Taalvoorkeur bijgewerkt."

